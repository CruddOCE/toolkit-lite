# Copy to .env and fill in. .env is gitignored and must never be committed.

# The address that receives the block reward if this ever wins. It must be an
# address you hold the keys for. Native segwit (bc1q...) is the safest choice
# for pool payout scripts.
BTC_ADDRESS=

# Solo pool. Winner takes the whole block, minus ckpool's 2%.
POOL_HOST=solo.ckpool.org
POOL_PORT=3333
WORKER_NAME=rig

# Off by default. Measured on this machine the CPU manages 2.0 MH/s against the
# GPU's 1.00 GH/s, so it buys 0.2% more hashrate for something like 90 W and a
# less responsive desktop. Blank means (physical cores - 1) if you want it back.
CPU_THREADS=0

# The GPU hashes in a browser page via WebGPU. Set to false for CPU only.
GPU_ENABLED=true

# Share difficulty to ask the pool for. Lower means more frequent shares, which
# is only about seeing the miner working: shares are a statistic on a solo pool
# and pay nothing. It has no effect whatsoever on the chance of a block. The pool
# is free to ignore or clamp this. Set to 0 to accept whatever the pool picks.
SUGGEST_DIFFICULTY=1

# Dashboard, also the WebSocket the GPU page connects back on. 8090 and 8091 are
# already used by other projects on this machine.
HTTP_PORT=8093

# GPU dispatch pauses entirely while any of these are running, so mining never
# competes with a stream or a game for the card. Comma separated, case
# insensitive. Set to an empty value to disable.
AUTOPAUSE_PROCESSES=obs64.exe,StarCitizen.exe

# How much of a thread budget to keep while paused, as a fraction.
PAUSED_CPU_FRACTION=0.25
